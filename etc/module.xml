<?xml version="1.0"?>
<!--
  OptAEO module declaration. Sequenced after the core modules it builds on:
  Catalog/Eav (GTIN + descriptive attribute data-patches), Review (review-summary
  API), Webapi (REST endpoints), Store (catalogue-aware protocol content), and the
  shipping stack the shipping-config API reads (Shipping/OfflineShipping/SalesRule).
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Optaeo_Aeo">
        <sequence>
            <module name="Magento_Eav"/>
            <module name="Magento_Catalog"/>
            <module name="Magento_Review"/>
            <module name="Magento_Webapi"/>
            <module name="Magento_Store"/>
            <module name="Magento_Shipping"/>
            <module name="Magento_OfflineShipping"/>
            <module name="Magento_SalesRule"/>
        </sequence>
    </module>
</config>
